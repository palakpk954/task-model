# Postgres Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=tesla_pool

# Backend Configuration
# For local dev without docker:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/tesla_pool?schema=public"
# Inside docker compose, db is resolved by service name:
# DATABASE_URL="postgresql://postgres:password@db:5432/tesla_pool?schema=public"
PORT=3001

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
